{
  "name": "pokebonk-deck",
  "productName": "Pok\u00e9Bonk Deck",
  "version": "1.3.4",
  "description": "Unofficial native Linux client for the Pok\u00e9Bonk browser game \u2014 built for Steam Deck.",
  "main": "src/main.js",
  "desktopName": "gg.pokebonk.deck.desktop",
  "license": "MIT",
  "private": true,
  "author": "forest",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "build": "electron-builder --linux AppImage --publish never",
    "build:publish": "electron-builder --linux AppImage --publish always",
    "build:all": "electron-builder --linux AppImage dir --publish never"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "gg.pokebonk.deck",
    "productName": "Pok\u00e9Bonk Deck",
    "artifactName": "PokebonkDeck-${version}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "assets",
      "executableName": "pokebonk-deck",
      "synopsis": "Unofficial native client for Pok\u00e9Bonk",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "StartupWMClass": "pokebonk-deck"
        }
      }
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "appImage": {
      "compression": "zstd"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "NaustudentX18",
        "repo": "pokebonk-deck",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  }
}
